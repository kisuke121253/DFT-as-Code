# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.

# --- Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Banco
POSTGRES_DB=dft
POSTGRES_USER=dft
POSTGRES_PASSWORD=troque-esta-senha

# --- API
API_PORT=8000
# Tokens aceitos (separados por vírgula). Vazio = API aberta, só para uso local.
DFT_API_TOKENS=
# URL pública da API (aparece nos links do GitHub e do webhook)
DFT_PUBLIC_URL=http://localhost:8000

# --- Fluxo DFT
FAULT_THREADS=1               # >1 dispara "Illegal instruction" no Fault 0.9.4 em sistemas novos
DFT_JOB_TIMEOUT_MIN=120
DFT_DEFAULT_MAX_DROP_PP=0.5   # usado quando o dft.yaml não define regression.max_drop_pp
WITH_QUAIGH=1                 # 0 = imagem do worker sem o Quaigh (build mais rápido)

# --- Integrações (opcionais)
DFT_WEBHOOK_URL=              # Slack/Discord/Teams: avisa reprovações e erros
DFT_GITHUB_TOKEN=             # token com permissão "commit statuses": publica o check no commit
DFT_GIT_TOKEN=                # token para clonar repositórios privados (POST /jobs/git)

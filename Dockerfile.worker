# Worker do DFT as Code: Yosys + Icarus Verilog + Fault 0.9.4 (+ Quaigh opcional).
#
# Base Ubuntu 24.04 de propósito: traz o Yosys 0.33 e o Icarus 12.0, as mesmas
# versões dos resultados da etapa 1. No Ubuntu 26.04 o Yosys 0.52 gera uma
# netlist um pouco diferente (MAC: 99,9% em vez de 100%). Fixar a imagem é o
# que torna a cobertura reprodutível entre máquinas.
#
#   docker build -f Dockerfile.worker -t dft-worker .
#   docker build -f Dockerfile.worker --build-arg WITH_QUAIGH=0 -t dft-worker .

ARG WITH_QUAIGH=1

# ---------- Quaigh (ATPG determinístico, compilado do crates.io)
FROM rust:1-slim-bookworm AS quaigh
ARG WITH_QUAIGH
RUN mkdir -p /opt/quaigh/bin && \
    if [ "$WITH_QUAIGH" = "1" ]; then \
        cargo install quaigh --version 0.0.6 --locked --root /opt/quaigh; \
    fi

# ---------- imagem final
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/quaigh/bin:$PATH \
    FAULT_THREADS=1 \
    DFT_DATA_DIR=/data \
    DFT_TECH_DIR=/app/tech

RUN apt-get update && apt-get install -y --no-install-recommends \
        yosys iverilog git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python 3.13: o fault-dft 0.9.4 não funciona no 3.14
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv
RUN uv venv --python 3.13 /opt/venv

WORKDIR /app
COPY requirements.txt .
RUN uv pip install --no-cache -r requirements.txt fault-dft==0.9.4

COPY --from=quaigh /opt/quaigh /opt/quaigh
COPY . .

RUN useradd --create-home --uid 1000 dft && mkdir -p /data && chown -R dft /data
USER dft

# -c 1: um job por container. Para medir throughput, escale containers:
#   docker compose up -d --scale worker=4
CMD ["celery", "-A", "dft_backend", "worker", "--loglevel=info", "--concurrency=1", "-Q", "dft", "-n", "worker@%h"]
